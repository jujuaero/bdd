@startuml ArtConnect_Model_ClassDiagram
!define ABSTRACT_COLOR #E1F5FF
!define ENTITY_COLOR #F3E5F5
!define ENUM_COLOR #FFF3E0

skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor ENTITY_COLOR
skinparam classArrowColor #424242
skinparam classBorderColor #616161
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ============= ENUMS =============
enum Status #FFF3E0 {
    FOR_SALE
    SOLD
    EXHIBITED
}

' ============= VALUE OBJECTS (lightweight entities) =============
class Discipline #FFF3E0 {
    -id: Long
    -name: String
    --
    +getId(): Long
    +setId(Long): void
    +getName(): String
    +setName(String): void
    +toString(): String
}

class ArtworkTag #FFF3E0 {
    -id: Long
    -name: String
    --
    +getId(): Long
    +setId(Long): void
    +getName(): String
    +setName(String): void
    +toString(): String
}

' ============= CORE ENTITIES =============
