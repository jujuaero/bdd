<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ArtistController">
    <padding>
        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
    </padding>
    <Label text="Artists" styleClass="section-title"/>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search artists..." HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="disciplineFilter" promptText="Filter by Discipline" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="Reset" onAction="#handleReset" styleClass="secondary" />
    </HBox>
    <HBox fx:id="crudToolbar" spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Add" onAction="#handleAddArtist" />
        <Button text="Edit" onAction="#handleEditArtist" styleClass="secondary" />
        <Button text="Delete" onAction="#handleDeleteArtist" styleClass="danger" />
        <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary" />
    </HBox>
    <TableView fx:id="artistTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="200" />
            <TableColumn fx:id="cityColumn" text="City" prefWidth="150" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200" />
            <TableColumn fx:id="yearColumn" text="Birth Year" prefWidth="100" />
        </columns>
    </TableView>
</VBox>
