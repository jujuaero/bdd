<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.BookingController">
    <padding>
        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
    </padding>
    <Label text="Bookings" styleClass="section-title"/>
    <HBox fx:id="crudToolbar" spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Add" onAction="#handleAddBooking" />
        <Button text="Edit" onAction="#handleEditBooking" styleClass="secondary" />
        <Button text="Delete" onAction="#handleDeleteBooking" styleClass="danger" />
        <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary" />
    </HBox>
    <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS" prefHeight="400">
        <columns>
            <TableColumn fx:id="memberNameColumn" text="Member" prefWidth="200" />
            <TableColumn fx:id="workshopTitleColumn" text="Workshop" prefWidth="250" />
            <TableColumn fx:id="bookingDateColumn" text="Booking Date" prefWidth="180" />
            <TableColumn fx:id="paymentStatusColumn" text="Payment Status" prefWidth="120" />
        </columns>
    </TableView>
</VBox>

