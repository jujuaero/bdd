<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="900.0" prefWidth="1300.0" minWidth="1100.0" minHeight="700.0" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.MainController">
    <MenuBar>
        <Menu text="Compte">
            <MenuItem text="Changer de rôle..." onAction="#handleSwitchAccount"/>
        </Menu>
        <Menu text="File">
            <MenuItem text="Exit" onAction="#handleExit"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About"/>
        </Menu>
    </MenuBar>

    <HBox alignment="CENTER_LEFT" styleClass="app-header">
        <Label text="ArtConnect Pro" styleClass="app-header-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Local Art Community Platform" styleClass="app-header-subtitle"/>
    </HBox>
    
    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Discover">
            <fx:include source="DiscoverTab.fxml"/>
        </Tab>
        <Tab text="Artists">
            <fx:include source="ArtistsTab.fxml"/>
        </Tab>
        <Tab text="Artworks">
            <fx:include source="ArtworksTab.fxml"/>
        </Tab>
        <Tab text="Galleries">
            <fx:include source="GalleriesTab.fxml"/>
        </Tab>
        <Tab text="Exhibitions">
            <fx:include source="ExhibitionsTab.fxml"/>
        </Tab>
        <Tab text="Workshops">
            <fx:include source="WorkshopsTab.fxml"/>
        </Tab>
        <Tab text="Community">
            <fx:include source="CommunityTab.fxml"/>
        </Tab>
    </TabPane>
    
    <HBox alignment="CENTER_RIGHT" styleClass="status-bar">
        <Label fx:id="modeLabel" text="ArtConnect Pro v1.0 | Mode: Unknown"/>
    </HBox>
</VBox>
