<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ArtworkController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <Label text="Artworks" style="-fx-font-size: 14; -fx-font-weight: bold;" />
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Add" onAction="#handleAddArtwork" />
        <Button text="Edit" onAction="#handleEditArtwork" />
        <Button text="Delete" onAction="#handleDeleteArtwork" />
        <Button text="Refresh" onAction="#handleRefresh" />
    </HBox>
    <TableView fx:id="artworkTable" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="200" />
            <TableColumn fx:id="artistColumn" text="Artist" prefWidth="150" />
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="100" />
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="100" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="150" />
        </columns>
    </TableView>
    <Separator />
    <Label text="Tags for Selected Artwork" style="-fx-font-size: 12; -fx-font-weight: bold;" />
    <TableView fx:id="tagsTable" prefHeight="150">
        <columns>
            <TableColumn fx:id="tagNameColumn" text="Tag Name" prefWidth="300" />
        </columns>
    </TableView>
    <Separator />
    <Label text="Reviews for Selected Artwork" style="-fx-font-size: 12; -fx-font-weight: bold;" />
    <TableView fx:id="reviewsTable" prefHeight="150">
        <columns>
            <TableColumn fx:id="reviewerColumn" text="Reviewer" prefWidth="150" />
            <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="80" />
            <TableColumn fx:id="commentColumn" text="Comment" prefWidth="300" />
        </columns>
    </TableView>
</VBox>
