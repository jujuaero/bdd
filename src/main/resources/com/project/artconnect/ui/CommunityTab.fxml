<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.CommunityController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <Label text="Community Members" style="-fx-font-size: 14; -fx-font-weight: bold;" />
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Add" onAction="#handleAddMember" />
        <Button text="Edit" onAction="#handleEditMember" />
        <Button text="Delete" onAction="#handleDeleteMember" />
        <Button text="Refresh" onAction="#handleRefresh" />
    </HBox>
    <TableView fx:id="memberTable" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="250" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="250" />
            <TableColumn fx:id="cityColumn" text="City" prefWidth="150" />
        </columns>
    </TableView>
    <Separator />
    <Label text="Disciplines" style="-fx-font-size: 12; -fx-font-weight: bold;" />
    <TableView fx:id="disciplinesTable" prefHeight="100">
        <columns>
            <TableColumn fx:id="disciplineNameColumn" text="Discipline" prefWidth="300" />
        </columns>
    </TableView>
</VBox>
