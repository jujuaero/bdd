<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.CommunityController">
    <padding>
        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
    </padding>
    <Label text="Community Members" styleClass="section-title"/>
    <HBox fx:id="crudToolbar" spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Add" onAction="#handleAddMember" />
        <Button text="Edit" onAction="#handleEditMember" styleClass="secondary" />
        <Button text="Delete" onAction="#handleDeleteMember" styleClass="danger" />
        <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary" />
    </HBox>
    <TableView fx:id="memberTable" VBox.vgrow="ALWAYS" prefHeight="350">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="250" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="250" />
            <TableColumn fx:id="cityColumn" text="City" prefWidth="150" />
        </columns>
    </TableView>
    <Separator />
    <Label text="Disciplines" styleClass="subsection-title"/>
    <TableView fx:id="disciplinesTable" prefHeight="100">
        <columns>
            <TableColumn fx:id="disciplineNameColumn" text="Discipline" prefWidth="300" />
        </columns>
    </TableView>
</VBox>
